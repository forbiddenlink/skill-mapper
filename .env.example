# Environment variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog Analytics (free tier: 1M events/mo)
# Get your key at: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Groq AI (fast inference for learning feedback)
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# Sentry Error Tracking (free tier: 5K errors/mo)
# Get your DSN at: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Axiom Log Aggregation (https://axiom.co - free 500GB/month)
NEXT_PUBLIC_AXIOM_DATASET=
AXIOM_TOKEN=
